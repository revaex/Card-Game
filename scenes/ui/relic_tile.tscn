[gd_scene format=3]

[node name="RelicTile" type="PanelContainer"]
custom_minimum_size = Vector2(300, 200)
theme_type_variation = &"BrowserPanel"

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 7

[node name="Tier" type="Label" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.74, 0.48, 1)
theme_override_font_sizes/font_size = 12

[node name="Title" type="Label" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CardTitle"
theme_override_font_sizes/font_size = 20

[node name="Description" type="Label" parent="Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(198, 0)
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/font_size = 14
autowrap_mode = 3

[node name="Status" type="Label" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.69, 0.75, 0.72, 1)
theme_override_font_sizes/font_size = 13
autowrap_mode = 3

[node name="Action" type="Button" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
mouse_default_cursor_shape = 2
text = "Equip"
