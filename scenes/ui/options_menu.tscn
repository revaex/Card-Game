visible = false
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Inset" type="MarginContainer" parent="Background/Margin/Content/Tabs/Gameplay"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/margin_left = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_top = 18
theme_override_constants/margin_bottom = 18

[node name="Rows" type="VBoxContainer" parent="Background/Margin/Content/Tabs/Gameplay/Inset"]
