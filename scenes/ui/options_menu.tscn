[node name="Quit" type="Button" parent="Background/Margin/Content/Footer"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(130, 40)
text = "Quit game"

[connection signal="pressed" from="Background/Margin/Content/Footer/Close" to="." method="_on_close_pressed"]
[connection signal="pressed" from="Background/Margin/Content/Footer/Quit" to="." method="_on_quit_pressed"]
[connection signal="pressed" from="Background/Margin/Content/SectionNav/PreviousTab" to="." method="_previous_tab"]
[connection signal="pressed" from="Background/Margin/Content/SectionNav/NextTab" to="." method="_next_tab"]
[connection signal="tab_changed" from="Background/Margin/Content/Tabs" to="." method="_tab_changed"]
[connection signal="item_selected" from="Background/Margin/Content/Tabs/Display/Inset/Rows/WindowModeRow/WindowMode" to="." method="_on_window_mode"]
[connection signal="item_selected" from="Background/Margin/Content/Tabs/Display/Inset/Rows/WindowSizeRow/WindowSize" to="." method="_on_window_size"]
[connection signal="value_changed" from="Background/Margin/Content/Tabs/Sound/Inset/Rows/LevelRow/Level" to="." method="_on_level_changed"]
[connection signal="value_changed" from="Background/Margin/Content/Tabs/Sound/Inset/Rows/EffectsRow/Effects" to="." method="_on_effects_changed"]
