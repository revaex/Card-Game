[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/options_menu.gd" id="options"]
[ext_resource type="Theme" path="res://data/ui/game_theme.tres" id="theme"]

[sub_resource type="StyleBoxFlat" id="SelectedTab"]
content_margin_left = 20.0
content_margin_right = 20.0
content_margin_top = 7.0
content_margin_bottom = 7.0
bg_color = Color(0.16, 0.22, 0.23, 1)
border_width_top = 2
border_color = Color(0.87, 0.71, 0.47, 1)

[sub_resource type="StyleBoxFlat" id="UnselectedTab"]
content_margin_left = 20.0
content_margin_right = 20.0
content_margin_top = 7.0
content_margin_bottom = 7.0
bg_color = Color(0.08, 0.13, 0.15, 1)

[sub_resource type="StyleBoxFlat" id="TabPanel"]
bg_color = Color(0.069, 0.112, 0.128, 1)
border_width_top = 1
border_width_bottom = 1
border_color = Color(0.34, 0.29, 0.23, 1)

[node name="OptionsMenu" type="Window"]
title = "Options"
visible = false
transient = true
exclusive = true
unresizable = true
borderless = true
theme = ExtResource("theme")
script = ExtResource("options")

[node name="Background" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.052, 0.092, 0.111, 1)

[node name="Margin" type="MarginContainer" parent="Background"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_right = 32
theme_override_constants/margin_top = 26
theme_override_constants/margin_bottom = 26

[node name="Content" type="VBoxContainer" parent="Background/Margin"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Kicker" type="Label" parent="Background/Margin/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.87, 0.71, 0.47, 1)
theme_override_font_sizes/font_size = 13
text = "INK & INTENT   /   TABLE PREFERENCES"

[node name="Heading" type="Label" parent="Background/Margin/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 40
theme_type_variation = &"CardTitle"
text = "Options"

[node name="Rule" type="HSeparator" parent="Background/Margin/Content"]
layout_mode = 2

[node name="SectionNav" type="HBoxContainer" parent="Background/Margin/Content"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="PreviousTab" type="Button" parent="Background/Margin/Content/SectionNav"]
unique_name_in_owner = true
layout_mode = 2
mouse_default_cursor_shape = 2
text = "‹  LB"

[node name="SectionIndex" type="Label" parent="Background/Margin/Content/SectionNav"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
horizontal_alignment = 1
theme_override_colors/font_color = Color(0.88, 0.72, 0.47, 1)
text = "01 / 04   ·   DISPLAY"

[node name="NextTab" type="Button" parent="Background/Margin/Content/SectionNav"]
unique_name_in_owner = true
layout_mode = 2
mouse_default_cursor_shape = 2
text = "RB  ›"

[node name="Tabs" type="TabContainer" parent="Background/Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
tab_alignment = 1
theme_override_styles/panel = SubResource("TabPanel")
theme_override_styles/tab_selected = SubResource("SelectedTab")
theme_override_styles/tab_hovered = SubResource("SelectedTab")
theme_override_styles/tab_unselected = SubResource("UnselectedTab")

[node name="Display" type="ScrollContainer" parent="Background/Margin/Content/Tabs"]
follow_focus = true
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Inset" type="MarginContainer" parent="Background/Margin/Content/Tabs/Display"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/margin_left = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_top = 18
theme_override_constants/margin_bottom = 18

[node name="Rows" type="VBoxContainer" parent="Background/Margin/Content/Tabs/Display/Inset"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Section" type="Label" parent="Background/Margin/Content/Tabs/Display/Inset/Rows"]
layout_mode = 2
theme_type_variation = &"CardTitle"
theme_override_font_sizes/font_size = 27
text = "Window & display"

[node name="DisplayDetail" type="Label" parent="Background/Margin/Content/Tabs/Display/Inset/Rows"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.67, 0.73, 0.70, 1)
text = "Window size is available in Windowed mode. Larger presets fit to the current monitor."
autowrap_mode = 3

[node name="WindowModeRow" type="HBoxContainer" parent="Background/Margin/Content/Tabs/Display/Inset/Rows"]
layout_mode = 2

[node name="Caption" type="Label" parent="Background/Margin/Content/Tabs/Display/Inset/Rows/WindowModeRow"]
custom_minimum_size = Vector2(190, 0)
layout_mode = 2
text = "Window mode"

[node name="WindowMode" type="OptionButton" parent="Background/Margin/Content/Tabs/Display/Inset/Rows/WindowModeRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(220, 38)
layout_mode = 2
item_count = 3
selected = 0
popup/item_0/text = "Windowed"
popup/item_0/id = 0
popup/item_1/text = "Maximized"
popup/item_1/id = 1
popup/item_2/text = "Fullscreen"
popup/item_2/id = 2

[node name="WindowSizeRow" type="HBoxContainer" parent="Background/Margin/Content/Tabs/Display/Inset/Rows"]
layout_mode = 2

[node name="Caption" type="Label" parent="Background/Margin/Content/Tabs/Display/Inset/Rows/WindowSizeRow"]
custom_minimum_size = Vector2(190, 0)
layout_mode = 2
text = "Window size"

[node name="WindowSize" type="OptionButton" parent="Background/Margin/Content/Tabs/Display/Inset/Rows/WindowSizeRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(220, 38)
layout_mode = 2
item_count = 4
selected = 0
popup/item_0/text = "1100 × 700"
popup/item_0/id = 0
popup/item_1/text = "1280 × 800"
popup/item_1/id = 1
popup/item_2/text = "1600 × 900"
popup/item_2/id = 2
popup/item_3/text = "1920 × 1080"
popup/item_3/id = 3

[node name="VSync" type="CheckButton" parent="Background/Margin/Content/Tabs/Display/Inset/Rows"]
unique_name_in_owner = true
layout_mode = 2
text = "Vertical sync"

[node name="WindowReadout" type="Label" parent="Background/Margin/Content/Tabs/Display/Inset/Rows"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.67, 0.73, 0.70, 1)
text = "Current window area: 1100 × 700"

[node name="Sound" type="ScrollContainer" parent="Background/Margin/Content/Tabs"]
follow_focus = true
visible = false
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Inset" type="MarginContainer" parent="Background/Margin/Content/Tabs/Sound"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/margin_left = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_top = 18
theme_override_constants/margin_bottom = 18

[node name="Rows" type="VBoxContainer" parent="Background/Margin/Content/Tabs/Sound/Inset"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Section" type="Label" parent="Background/Margin/Content/Tabs/Sound/Inset/Rows"]
layout_mode = 2
theme_type_variation = &"CardTitle"
theme_override_font_sizes/font_size = 27
text = "Sound levels"

[node name="Detail" type="Label" parent="Background/Margin/Content/Tabs/Sound/Inset/Rows"]
layout_mode = 2
theme_override_colors/font_color = Color(0.67, 0.73, 0.70, 1)
text = "Set the overall volume and balance the combat cues."
autowrap_mode = 3

[node name="LevelRow" type="HBoxContainer" parent="Background/Margin/Content/Tabs/Sound/Inset/Rows"]
layout_mode = 2

[node name="Volume" type="Label" parent="Background/Margin/Content/Tabs/Sound/Inset/Rows/LevelRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(190, 0)
layout_mode = 2
text = "Master volume 100%"

[node name="Level" type="HSlider" parent="Background/Margin/Content/Tabs/Sound/Inset/Rows/LevelRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(220, 38)
layout_mode = 2
size_flags_horizontal = 3
max_value = 100.0
step = 5.0
value = 100.0

[node name="EffectsRow" type="HBoxContainer" parent="Background/Margin/Content/Tabs/Sound/Inset/Rows"]
layout_mode = 2

[node name="EffectsVolume" type="Label" parent="Background/Margin/Content/Tabs/Sound/Inset/Rows/EffectsRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(190, 0)
layout_mode = 2
text = "Effects volume 100%"

[node name="Effects" type="HSlider" parent="Background/Margin/Content/Tabs/Sound/Inset/Rows/EffectsRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(220, 38)
layout_mode = 2
size_flags_horizontal = 3
max_value = 100.0
step = 5.0
value = 100.0

[node name="Sound" type="CheckButton" parent="Background/Margin/Content/Tabs/Sound/Inset/Rows"]
unique_name_in_owner = true
layout_mode = 2
text = "Combat sound effects"

[node name="Controls" type="ScrollContainer" parent="Background/Margin/Content/Tabs"]
follow_focus = true
visible = false
layout_mode = 2
