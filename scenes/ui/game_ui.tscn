[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/ui/game_ui.gd" id="controller"]
[ext_resource type="Script" path="res://scripts/ui/ink_backdrop.gd" id="backdrop"]
[ext_resource type="PackedScene" path="res://scenes/ui/main_menu.tscn" id="menu"]
[ext_resource type="Theme" path="res://data/ui/game_theme.tres" id="theme"]
[ext_resource type="Script" path="res://scripts/ui/focus_help.gd" id="focus_help"]
[ext_resource type="Script" path="res://scripts/ui/end_journey_dialog.gd" id="end_journey_dialog"]

[node name="GameUI" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("theme")
script = ExtResource("controller")

[node name="InkBackdrop" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("backdrop")

[node name="ScreenMargin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_bottom = 24

[node name="PageScroll" type="ScrollContainer" parent="ScreenMargin"]
follow_focus = true
unique_name_in_owner = true
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Screens" type="VBoxContainer" parent="ScreenMargin/PageScroll"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="MainMenu" parent="ScreenMargin/PageScroll/Screens" instance=ExtResource("menu")]
unique_name_in_owner = true
layout_mode = 2

[node name="Body" type="VBoxContainer" parent="ScreenMargin/PageScroll/Screens"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 10

[node name="FocusHelp" type="Control" parent="."]
unique_name_in_owner = true
mouse_filter = 2
z_index = 100
script = ExtResource("focus_help")

[node name="EndJourneyDialog" type="ConfirmationDialog" parent="."]
unique_name_in_owner = true
title = "End this journey?"
visible = false
transient = true
exclusive = true
dialog_text = "You’ll leave the route and lose this run’s progress."
ok_button_text = "End journey"
script = ExtResource("end_journey_dialog")
