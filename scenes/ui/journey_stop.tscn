[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/duel_art.gd" id="art"]

[node name="RouteStop" type="VBoxContainer"]
size_flags_horizontal = 3
theme_override_constants/separation = 5

[node name="Region" type="Label" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "01  /  ASH GATE"
horizontal_alignment = 1

[node name="Inspect" type="Button" parent="."]
custom_minimum_size = Vector2(104, 92)
layout_mode = 2
size_flags_horizontal = 4
mouse_default_cursor_shape = 2

[node name="Emblem" type="Control" parent="Inspect"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
script = ExtResource("art")

[node name="Rival" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"CardTitle"
theme_override_font_sizes/font_size = 21
text = "The Duelist"
horizontal_alignment = 1
text_overrun_behavior = 3

[node name="State" type="Label" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "◆  NEXT DUEL"
horizontal_alignment = 1
