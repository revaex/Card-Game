[gd_scene format=3]

[node name="PageHeading" type="VBoxContainer"]
theme_override_constants/separation = 6

[node name="Imprint" type="Label" parent="."]
layout_mode = 2
theme_override_colors/font_color = Color(0.812, 0.667, 0.4, 1)
theme_override_font_sizes/font_size = 12
text = "INK & INTENT"

[node name="Title" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CardTitle"
theme_override_font_sizes/font_size = 32
autowrap_mode = 3

[node name="Subtitle" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.64, 0.7, 0.67, 1)
theme_override_font_sizes/font_size = 16
autowrap_mode = 3

[node name="Rule" type="HSeparator" parent="."]
layout_mode = 2
