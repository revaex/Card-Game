[gd_scene load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/ui/main_menu.gd" id="controller"]
[ext_resource type="Script" path="res://scripts/ui/info_label.gd" id="label"]
[ext_resource type="Script" path="res://scripts/ui/info_button.gd" id="button"]
[ext_resource type="Texture2D" path="res://data/ui/duelist_plate.svg" id="art"]
[ext_resource type="Theme" path="res://data/ui/game_theme.tres" id="theme"]

[sub_resource type="StyleBoxFlat" id="PrimaryNormal"]
bg_color = Color(0.878, 0.725, 0.475, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.94, 0.83, 0.63, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_left = 6
corner_radius_bottom_right = 6
content_margin_left = 20.0
content_margin_right = 20.0
content_margin_top = 10.0
content_margin_bottom = 10.0

[sub_resource type="StyleBoxFlat" id="PrimaryHover"]
bg_color = Color(0.953, 0.808, 0.573, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.957, 0.878, 0.71, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_left = 6
corner_radius_bottom_right = 6
content_margin_left = 20.0
content_margin_right = 20.0
content_margin_top = 10.0
content_margin_bottom = 10.0

[node name="MainMenu" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme = ExtResource("theme")
script = ExtResource("controller")

[node name="Brand" type="Label" parent="."]
layout_mode = 2
theme_override_colors/font_color = Color(0.812, 0.667, 0.4, 1)
theme_override_font_sizes/font_size = 14
text = "THE DUELIST’S ALMANAC"
script = ExtResource("label")

[node name="HeaderRule" type="HSeparator" parent="."]
layout_mode = 2

[node name="Hero" type="HBoxContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 26

[node name="Copy" type="VBoxContainer" parent="Hero"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 1.05
theme_override_constants/separation = 15
alignment = 1

[node name="Eyebrow" type="Label" parent="Hero/Copy"]
layout_mode = 2
theme_override_colors/font_color = Color(0.886, 0.584, 0.467, 1)
theme_override_font_sizes/font_size = 13
text = "A TACTICAL DECKBUILDER"
script = ExtResource("label")

[node name="Title" type="Label" parent="Hero/Copy"]
layout_mode = 2
theme_type_variation = &"CardTitle"
theme_override_font_sizes/font_size = 67
text = "Ink & Intent"
script = ExtResource("label")

[node name="Description" type="Label" parent="Hero/Copy"]
layout_mode = 2
theme_override_colors/font_color = Color(0.737, 0.775, 0.737, 1)
theme_override_font_sizes/font_size = 19
text = "Read your rival’s next move.\nBuild a hand that can change it."
autowrap_mode = 3
script = ExtResource("label")

[node name="Featured" type="HBoxContainer" parent="Hero/Copy"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="JourneyButton" type="Button" parent="Hero/Copy/Featured"]
unique_name_in_owner = true
custom_minimum_size = Vector2(230, 50)
layout_mode = 2
size_flags_horizontal = 0
mouse_default_cursor_shape = 2
theme_override_font_sizes/font_size = 19
theme_override_colors/font_color = Color(0.082, 0.141, 0.149, 1)
theme_override_colors/font_hover_color = Color(0.082, 0.141, 0.149, 1)
theme_override_colors/font_pressed_color = Color(0.082, 0.141, 0.149, 1)
theme_override_styles/normal = SubResource("PrimaryNormal")
theme_override_styles/hover = SubResource("PrimaryHover")
theme_override_styles/pressed = SubResource("PrimaryNormal")
text = "Begin a journey  →"
script = ExtResource("button")

[node name="LessonButton" type="Button" parent="Hero/Copy/Featured"]
custom_minimum_size = Vector2(146, 50)
layout_mode = 2
size_flags_vertical = 1
mouse_default_cursor_shape = 2
text = "Learn to duel"
script = ExtResource("button")

[node name="ModeGrid" type="GridContainer" parent="Hero/Copy"]
layout_mode = 2
size_flags_horizontal = 0
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8
columns = 2

[node name="SingleDuelButton" type="Button" parent="Hero/Copy/ModeGrid"]
custom_minimum_size = Vector2(188, 42)
layout_mode = 2
size_flags_horizontal = 3
mouse_default_cursor_shape = 2
text = "Challenge a rival"
script = ExtResource("button")

[node name="CustomDuelButton" type="Button" parent="Hero/Copy/ModeGrid"]
custom_minimum_size = Vector2(188, 42)
layout_mode = 2
size_flags_horizontal = 3
mouse_default_cursor_shape = 2
text = "Custom duel"
script = ExtResource("button")

[node name="DecksButton" type="Button" parent="Hero/Copy/ModeGrid"]
custom_minimum_size = Vector2(188, 42)
layout_mode = 2
size_flags_horizontal = 3
mouse_default_cursor_shape = 2
text = "Deck library"
script = ExtResource("button")

[node name="RelicsButton" type="Button" parent="Hero/Copy/ModeGrid"]
unique_name_in_owner = true
custom_minimum_size = Vector2(188, 42)
layout_mode = 2
size_flags_horizontal = 3
mouse_default_cursor_shape = 2
text = "Relic collection"
script = ExtResource("button")

[node name="DuelistPlate" type="TextureRect" parent="Hero"]
custom_minimum_size = Vector2(325, 360)
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
texture = ExtResource("art")
expand_mode = 1
stretch_mode = 5

[node name="FooterRule" type="HSeparator" parent="."]
layout_mode = 2

[node name="Footer" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="SaveNote" type="Label" parent="Footer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.608, 0.663, 0.643, 1)
theme_override_font_sizes/font_size = 13
text = "Decks and relics are saved on this device."
script = ExtResource("label")

[node name="OptionsButton" type="Button" parent="Footer"]
layout_mode = 2
mouse_default_cursor_shape = 2
text = "Options"
script = ExtResource("button")

[node name="QuitButton" type="Button" parent="Footer"]
layout_mode = 2
mouse_default_cursor_shape = 2
text = "Quit"
script = ExtResource("button")

[connection signal="pressed" from="Hero/Copy/Featured/JourneyButton" to="." method="_on_journey_pressed"]
[connection signal="pressed" from="Hero/Copy/Featured/LessonButton" to="." method="_on_lesson_pressed"]
[connection signal="pressed" from="Hero/Copy/ModeGrid/RelicsButton" to="." method="_on_relics_pressed"]
[connection signal="pressed" from="Hero/Copy/ModeGrid/SingleDuelButton" to="." method="_on_single_pressed"]
[connection signal="pressed" from="Hero/Copy/ModeGrid/CustomDuelButton" to="." method="_on_custom_pressed"]
[connection signal="pressed" from="Hero/Copy/ModeGrid/DecksButton" to="." method="_on_decks_pressed"]
[connection signal="pressed" from="Footer/OptionsButton" to="." method="_on_options_pressed"]
[connection signal="pressed" from="Footer/QuitButton" to="." method="_on_quit_pressed"]
