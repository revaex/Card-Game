[node name="CombatAudio" parent="." instance=ExtResource("audio")]

[connection signal="pressed" from="Middle/Field/Actions/EndTurnButton" to="." method="end_turn"]
[connection signal="pressed" from="Middle/Field/Actions/Brace" to="." method="_on_brace_pressed"]
[connection signal="pressed" from="Middle/Field/Actions/CadenceDraw" to="." method="_on_cadence_draw_pressed"]
[connection signal="pressed" from="Middle/Field/Actions/MarginBurn" to="." method="show_margin_burn"]
[connection signal="toggled" from="Middle/Field/Actions/LabToggle" to="." method="_on_lab_toggled"]
[connection signal="pressed" from="Middle/Field/DebugActions/DrawButton" to="." method="draw_one"]
[connection signal="pressed" from="Middle/Field/DebugActions/RedrawButton" to="." method="next_hand"]
[connection signal="pressed" from="HandHeading/PatternGuideButton" to="." method="show_pattern_guide"]
[connection signal="timeout" from="RivalTimer" to="." method="advance_rival_presentation"]
[connection signal="timeout" from="LessonDelay" to="." method="_on_lesson_delay_timeout"]

