grow_vertical = 2
vertical_scroll_mode = 0

[node name="RewriteRow" type="HBoxContainer" parent="IntentBand/Content/Stage/IntentScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10
alignment = 1

[node name="RewriteFX" type="Control" parent="IntentBand/Content/Stage"]
unique_name_in_owner = true
