[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/card_browser.gd" id="browser"]
[ext_resource type="Theme" path="res://data/ui/game_theme.tres" id="theme"]

[node name="CardBrowser" type="Window"]
title = "Card almanac"
visible = false
transient = true
exclusive = true
unresizable = true
theme = ExtResource("theme")
script = ExtResource("browser")

[node name="Panel" type="PanelContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"BrowserPanel"

[node name="Content" type="VBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Summary" type="Label" parent="Panel/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.812, 0.667, 0.4, 1)
text = "0 cards"
autowrap_mode = 3

[node name="Rule" type="HSeparator" parent="Panel/Content"]
layout_mode = 2

[node name="Scroll" type="ScrollContainer" parent="Panel/Content"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Cards" type="HFlowContainer" parent="Panel/Content/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/h_separation = 12
theme_override_constants/v_separation = 14

[node name="Empty" type="Label" parent="Panel/Content"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
text = "No cards here."
horizontal_alignment = 1
vertical_alignment = 1

[node name="Close" type="Button" parent="Panel/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 38)
layout_mode = 2
size_flags_horizontal = 8
mouse_default_cursor_shape = 2
text = "Close"

[connection signal="pressed" from="Panel/Content/Close" to="." method="_on_close_pressed"]
