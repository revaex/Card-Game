[gd_scene format=3]

[node name="DeckEditor" type="VBoxContainer"]
theme_override_constants/separation = 16

[node name="Toolbar" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="Total" type="Label" parent="Toolbar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "0 cards in deck"

[node name="Done" type="Button" parent="Toolbar"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(120, 40)
mouse_default_cursor_shape = 2
text = "Done  →"

[node name="Rule" type="HSeparator" parent="."]
layout_mode = 2

[node name="JourneyStatus" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3

[node name="Workshop" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 16

[node name="CatalogueScroll" type="ScrollContainer" parent="Workshop"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 380)
layout_mode = 2
size_flags_horizontal = 3
follow_focus = true
horizontal_scroll_mode = 0

[node name="Cards" type="HFlowContainer" parent="Workshop/CatalogueScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/h_separation = 14
theme_override_constants/v_separation = 18

[node name="DeckTray" type="PanelContainer" parent="Workshop"]
unique_name_in_owner = true
custom_minimum_size = Vector2(242, 0)
layout_mode = 2
size_flags_vertical = 0

[node name="Contents" type="VBoxContainer" parent="Workshop/DeckTray"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Heading" type="Label" parent="Workshop/DeckTray/Contents"]
layout_mode = 2
theme_override_font_sizes/font_size = 19
text = "In this deck"

[node name="EquippedRelic" type="Label" parent="Workshop/DeckTray/Contents"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 13
autowrap_mode = 3

[node name="EmptyDeck" type="Label" parent="Workshop/DeckTray/Contents"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "Add a card to get started."

[node name="DeckContents" type="VBoxContainer" parent="Workshop/DeckTray/Contents"]
unique_name_in_owner = true
layout_mode = 2
