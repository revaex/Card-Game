[gd_resource type="Resource" script_class="CardDefinition" format=3]

[ext_resource type="Script" path="res://scripts/cards/card_definition.gd" id="1"]
[ext_resource type="Script" path="res://scripts/effects/card_effect.gd" id="2"]
[ext_resource type="Script" path="res://scripts/effects/gain_block_effect.gd" id="3"]
[ext_resource type="Script" path="res://scripts/effects/draw_effect.gd" id="4"]

[sub_resource type="Resource" id="Block"]
script = ExtResource("3")
block_amount = 4

[sub_resource type="Resource" id="Draw"]
script = ExtResource("4")
amount = 1

[resource]
script = ExtResource("1")
id = &"switchback"
display_name = "Switchback"
description = "Gain 4 block. Draw 1 card."
category = 1
effects = Array[ExtResource("2")]([SubResource("Block"), SubResource("Draw")])
