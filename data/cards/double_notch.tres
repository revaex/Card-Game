damage = 8

[resource]
script = ExtResource("card")
id = &"double_notch"
display_name = "Double Notch"
description = "Deal 8 damage. Deal 8 damage."
energy_cost = 2
category = 0
effects = Array[ExtResource("effect")]([SubResource("Effect0"), SubResource("Effect1")])
