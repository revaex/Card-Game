[gd_resource type="Resource" script_class="CardDefinition" format=3]

[ext_resource type="Script" path="res://scripts/cards/card_definition.gd" id="card"]
[ext_resource type="Script" path="res://scripts/effects/card_effect.gd" id="effect"]
[ext_resource type="Script" path="res://scripts/effects/damage_effect.gd" id="damage"]
[ext_resource type="Script" path="res://scripts/effects/draw_effect.gd" id="draw"]

[sub_resource type="Resource" id="Effect0"]
script = ExtResource("damage")
damage = 3

[sub_resource type="Resource" id="Effect1"]
script = ExtResource("draw")
after_rewrite = true
amount = 2

[resource]
script = ExtResource("card")
id = &"revision_note"
display_name = "Revision Note"
description = "Deal 3 damage. After Rewrite: Draw 2 cards."
energy_cost = 1
category = 2
effects = Array[ExtResource("effect")]([SubResource("Effect0"), SubResource("Effect1")])
