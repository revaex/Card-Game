[gd_resource type="Resource" format=3]
[ext_resource type="Script" path="res://scripts/content/rival_definition.gd" id="rival"]
[ext_resource type="Script" path="res://scripts/cards/card_definition.gd" id="card"]
[ext_resource type="Resource" path="res://data/cards/strike.tres" id="strike"]
[ext_resource type="Resource" path="res://data/cards/block.tres" id="block"]
[ext_resource type="Resource" path="res://data/cards/mend.tres" id="mend"]
[ext_resource type="Resource" path="res://data/cards/switchback.tres" id="switchback"]

[resource]
script = ExtResource("rival")
display_name = "The Warden"
epithet = "Every wall has a missing word."
description = "Builds a guard before attacking. Rewrite a defensive move to open a gap, or prepare a Pattern to break through."
doctrine = 1
health = 46
accent = Color(0.45, 0.68, 0.79, 1)
cards = Array[ExtResource("card")]([ExtResource("block"), ExtResource("block"), ExtResource("block"), ExtResource("block"), ExtResource("strike"), ExtResource("strike"), ExtResource("strike"), ExtResource("mend"), ExtResource("mend"), ExtResource("switchback")])
