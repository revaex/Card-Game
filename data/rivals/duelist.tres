[gd_resource type="Resource" format=3]
[ext_resource type="Script" path="res://scripts/content/rival_definition.gd" id="rival"]
[ext_resource type="Script" path="res://scripts/cards/card_definition.gd" id="card"]
[ext_resource type="Resource" path="res://data/cards/strike.tres" id="strike"]
[ext_resource type="Resource" path="res://data/cards/crosscut.tres" id="crosscut"]
[ext_resource type="Resource" path="res://data/cards/block.tres" id="block"]

[resource]
script = ExtResource("rival")
display_name = "The Duelist"
epithet = "The first stroke is a promise."
description = "Commits attacks to the front of the line. Break the opening assault, then choose your moment to strike."
health = 36
accent = Color(0.85, 0.49, 0.39, 1)
cards = Array[ExtResource("card")]([ExtResource("strike"), ExtResource("strike"), ExtResource("strike"), ExtResource("strike"), ExtResource("strike"), ExtResource("strike"), ExtResource("crosscut"), ExtResource("crosscut"), ExtResource("block"), ExtResource("block")])
